{
  "name": "quantaenergi",
  "version": "2.0.0",
  "description": "QuantaEnergi - Next-Generation ETRM/CTRM Trading Platform with Advanced Risk Management",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd apps/backend && python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "cd apps/frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd apps/backend && python -m pip install -r requirements.txt",
    "build:frontend": "cd apps/frontend && npm run build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd apps/backend && python -m uvicorn main:app --host 0.0.0.0 --port 8000",
    "start:frontend": "cd apps/frontend && npm run start",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd apps/backend && python -m pytest tests/ -v --cov=apps/backend --cov-report=html",
    "test:frontend": "cd apps/frontend && npm run test",
    "test:e2e": "cd apps/frontend && npm run test:e2e",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd apps/backend && python -m flake8 apps/backend --max-line-length=120",
    "lint:frontend": "cd apps/frontend && npm run lint",
    "format": "npm run format:backend && npm run format:frontend",
    "format:backend": "cd apps/backend && python -m black apps/backend --line-length=120",
    "format:frontend": "cd apps/frontend && npm run lint:fix",
    "deploy": "./deploy.sh",
    "deploy:staging": "ENVIRONMENT=staging ./deploy.sh",
    "deploy:production": "ENVIRONMENT=production ./deploy.sh",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "migrate": "cd apps/backend && python -m alembic upgrade head",
    "migrate:create": "cd apps/backend && python -m alembic revision --autogenerate -m",
    "seed": "cd apps/backend && python -m scripts.seed_data",
    "clean": "npm run clean:backend && npm run clean:frontend",
    "clean:backend": "cd apps/backend && find . -type d -name __pycache__ -exec rm -rf {} + && find . -name '*.pyc' -delete",
    "clean:frontend": "cd apps/frontend && rm -rf node_modules dist .next",
    "install:all": "npm install && cd apps/backend && pip install -r requirements.txt && cd ../frontend && npm install",
    "security:audit": "npm audit && cd apps/backend && pip-audit",
    "security:scan": "cd apps/backend && bandit -r apps/backend -f json -o security-report.json",
    "performance:test": "cd apps/backend && python -m pytest tests/performance/ -v",
    "load:test": "cd apps/backend && python -m locust -f tests/load/locustfile.py --host=http://localhost:8000",
    "monitor": "cd apps/backend && python -m scripts.monitor",
    "backup": "cd apps/backend && python -m scripts.backup",
    "restore": "cd apps/backend && python -m scripts.restore",
    "health:check": "curl -f http://localhost:8000/health || exit 1",
    "docs:generate": "cd apps/backend && python -m scripts.generate_docs",
    "docs:serve": "cd apps/backend && python -m http.server 8080 -d docs/build/html"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "semantic-release": "^22.0.12"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0",
    "python": ">=3.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/akramahmed1/QuantaEnergi.git"
  },
  "keywords": [
    "etrm",
    "ctrm",
    "energy-trading",
    "commodity-trading",
    "risk-management",
    "derivatives",
    "ppa",
    "carbon-trading",
    "treasury-management",
    "multi-tenancy",
    "python",
    "fastapi",
    "react",
    "typescript",
    "kubernetes",
    "microservices",
    "blockchain",
    "ai",
    "machine-learning"
  ],
  "author": "QuantaEnergi Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/akramahmed1/QuantaEnergi/issues"
  },
  "homepage": "https://github.com/akramahmed1/QuantaEnergi#readme",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.py": [
      "black --line-length=120",
      "flake8 --max-line-length=120"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
