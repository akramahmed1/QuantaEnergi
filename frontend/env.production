# QuantaEnergi Frontend Production Environment Variables

VITE_API_URL=https://quantaenergi-backend.railway.app
VITE_WS_URL=wss://quantaenergi-backend.railway.app
VITE_APP_NAME=QuantaEnergi
VITE_APP_VERSION=2.0.0
VITE_APP_DESCRIPTION=Next-Gen ETRM/CTRM Trading Platform

# Feature Flags
VITE_ENABLE_QUANTUM=true
VITE_ENABLE_GEO_RISK=true
VITE_ENABLE_REMIT_COMPLIANCE=true
VITE_ENABLE_ALPHA_VANTAGE=true

# Analytics
VITE_ANALYTICS_ENABLED=true
VITE_ANALYTICS_ID=your-analytics-id

# Monitoring
VITE_MONITORING_ENABLED=true
VITE_SENTRY_DSN=your-sentry-dsn

# API Configuration
VITE_API_TIMEOUT=30000
VITE_WS_RECONNECT_INTERVAL=5000
VITE_MAX_RETRIES=3

# UI Configuration
VITE_THEME=dark
VITE_LANGUAGE=en
VITE_CURRENCY=USD
VITE_TIMEZONE=UTC

# Security
VITE_JWT_STORAGE_KEY=quantaenergi_token
VITE_REFRESH_TOKEN_KEY=quantaenergi_refresh