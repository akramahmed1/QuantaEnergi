# QuantaEnergi Production Environment Variables Template
# Copy this to .env and fill in your values

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:pass@localhost:5432/quanta_db

# Redis (Railway Redis)
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# CORS
CORS_ORIGINS=["https://quantaenergi-frontend.vercel.app","https://quantaenergi.vercel.app"]

# Alpha Vantage API
ALPHA_VANTAGE_API_KEY=demo

# External APIs
MARKET_DATA_API_URL=https://api.alphavantage.co
GEO_RISK_API_URL=https://api.georisk.com

# Monitoring
PROMETHEUS_ENABLED=true
METRICS_ENABLED=true

# Quantum Computing
QUANTUM_ENABLED=true
QISKIT_TOKEN=your-qiskit-token

# Compliance
REMIT_ENABLED=true
ACER_REPORTING_URL=https://acer.europa.eu