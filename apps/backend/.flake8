[flake8]
max-line-length = 88
extend-ignore = E203, W503, E501
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    .tox,
    .eggs,
    *.egg,
    build,
    dist,
    .mypy_cache,
    .pytest_cache,
    migrations,
    alembic/versions
per-file-ignores =
    __init__.py:F401
    tests/*:S101
max-complexity = 10
select = C,E,F,W,B,B950
