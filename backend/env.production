# Production Environment Variables for QuantaEnergi Backend
DATABASE_URL=postgresql://user:pass@localhost:5432/quantaenergi_prod
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=quantaenergi.com
JWT_AUDIENCE=quantaenergi-api

# Security Settings
TLS_ENABLED=true
RATE_LIMIT_ENABLED=true
AUDIT_LOGGING_ENABLED=true
ENCRYPTION_AT_REST=true
ENCRYPTION_IN_TRANSIT=true
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true

# API Configuration
API_BASE_URL=https://quantaenergi-backend.railway.app
CORS_ORIGINS=["https://quantaenergi.vercel.app", "https://quantaenergi-frontend.vercel.app"]

# Compliance Settings
COMPLIANCE_MODE=strict
DATA_RETENTION_DAYS=2555

# Monitoring
MONITORING_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json
